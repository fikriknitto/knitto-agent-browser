    "@modelcontextprotocol/sdk": "^1.0.1",
    "ai": "6.0.97",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^4.21.2",
    "fast-xml-parser": "^5.9.3",
    "multer": "^2.2.0",
    "openai": "^4.104.0",
    "playwright": "^1.61.1",
    "webdriverio": "^9.29.1",
    "ws": "^8.18.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.1.0",
    "@types/node": "^24.0.0",
