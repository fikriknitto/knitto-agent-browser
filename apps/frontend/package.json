    "@tanstack/react-virtual": "^3.13.18",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.19",
    "js-cookie": "^3.0.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.71.1",
    "react-redux": "^8.1.3",
